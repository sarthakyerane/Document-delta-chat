# ════════════════════════════════════════════════════════════════════════════════
# delta-chat · environment variables
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════════

# ── LLM Providers ──────────────────────────────────────────────────────────────
# Provider order: first available wins; each serves as fallback for the previous.
# Pattern mirrors CodeSage 3-tier fallback: zero-downtime, no hard dependency.
LLM_PROVIDER_ORDER=groq,gemini,ollama

# Tier 1 — Groq (fastest inference, primary)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tier 2 — Google Gemini (vision OCR + embeddings + LLM fallback)
GOOGLE_API_KEY=AIza_your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# gemini-2.5-flash chosen over text-embedding-004+tesseract because:
# one VLM call recovers text, element type, bbox region simultaneously
# avoiding a second classification pass; cost ~$0.001-0.003/page.

# Tier 3 — Ollama (local, zero cost, slowest)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Database ───────────────────────────────────────────────────────────────────
# MySQL (production — requires docker compose up or a live MySQL server)
DATABASE_URL=mysql+pymysql://delta_user:delta_pass@localhost:3306/delta_chat

# SQLite alternative (uncomment for local dev without Docker, comment out MySQL above)
# DATABASE_URL=sqlite:///./delta_chat.db

# ── Redis (semantic cache) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
# Cosine similarity threshold for cache hit (0.90 mirrors Meeting Intelligence Agent)
REDIS_SEMANTIC_CACHE_THRESHOLD=0.90
# TTL for cached answers (seconds)
REDIS_CACHE_TTL=3600

# ── ChromaDB ───────────────────────────────────────────────────────────────────
# Embedded mode (default) — no extra container needed
CHROMA_PERSIST_DIR=./data/chroma
# ChromaDB server mode (optional — uncomment if running chroma as a service)
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# ── Delta Engine ───────────────────────────────────────────────────────────────
# LLM is used ONLY when deterministic signals are ambiguous (0.40 < best_score < 0.75)
# Above ALIGNMENT_TEXT_SIM_HIGH: deterministic match, no LLM call
# Between MEDIUM and HIGH: medium-confidence deterministic match
# Between LLM_MIN and MEDIUM: LLM disambiguation call
# Below LLM_MIN: no match attempted (element marked added/removed)
ALIGNMENT_TEXT_SIM_HIGH=0.85
ALIGNMENT_TEXT_SIM_MEDIUM=0.70
ALIGNMENT_TEXT_SIM_LLM_MIN=0.40
ALIGNMENT_BBOX_IOU_HIGH=0.70
ALIGNMENT_USE_LLM=true
ALIGNMENT_LLM_BATCH_SIZE=10

# ── OCR ────────────────────────────────────────────────────────────────────────
OCR_PROVIDER=gemini        # gemini | tesseract
OCR_DPI=200                # page rasterization DPI for scanned PDFs
OCR_CONFIDENCE_THRESHOLD=0.60

# ── Retrieval / Chat ───────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=6          # chunks retrieved per collection (A, B, delta) per query
RETRIEVAL_SIMILARITY_THRESHOLD=0.70
CHAT_MAX_CONTEXT_TOKENS=6000
# When retrieval returns nothing above threshold, emit explicit "insufficient grounding"
CHAT_INSUFFICIENT_GROUNDING_MSG=true

# ── Observability ──────────────────────────────────────────────────────────────
TRACES_DIR=./traces
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | console (pretty for local dev, json for prod)
OTEL_SERVICE_NAME=delta-chat
OTEL_SERVICE_VERSION=0.1.0

# ── Markup (bonus) ─────────────────────────────────────────────────────────────
MARKUP_OUTPUT_DIR=./data/markup
MARKUP_BOX_COLOR_ADD=00CC44      # hex without #: green for additions
MARKUP_BOX_COLOR_REMOVE=CC2200   # red for removals
MARKUP_BOX_COLOR_MODIFY=CCAA00   # amber for modifications
MARKUP_LINE_WIDTH=2

# ── DWG ────────────────────────────────────────────────────────────────────────
# Path to ODA File Converter CLI binary (for .dwg → .dxf conversion)
# Leave empty to use ezdxf's partial .dwg support or the documented stub behaviour
DWG_ODA_CONVERTER_PATH=

# ── Cost estimation (USD per 1K tokens — static table, configurable) ──────────
COST_GROQ_INPUT=0.00059
COST_GROQ_OUTPUT=0.00079
COST_GEMINI_INPUT=0.000075
COST_GEMINI_OUTPUT=0.0003
COST_OLLAMA_INPUT=0.0
COST_OLLAMA_OUTPUT=0.0
